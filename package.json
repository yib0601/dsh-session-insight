{
  "name": "@local/dsh-turn-cost",
  "version": "1.16.0",
  "private": true,
  "type": "module",
  "description": "Per-turn and session cost in CNY/USD at official list prices, plus context-insight dashboard, Context tab with a four-level item breakdown (window summary, tab with counts, per-bucket scale, labelled rows with per tool schema, per system-prompt section, per message kind), model-catalog auto-sync for gateway routes (cache-first: a 模型目录 settings page and a header chip paint the stored list, then revalidate the provider's /v1/models behind the panel and write drift through the settings service), /context-style command and the live subscription quota at the sidebar foot (DeepSeek balance, OpenCode Go rolling/weekly/monthly usage, or WorkBuddy credit packages read through the user's gateway shim).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "cost-tracking",
    "token-usage",
    "llm-pricing",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.context.js": "./client.context.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client.memory.js": "./client.memory.js"
  },
  "files": [
    "index.js",
    "client.js",
    "client.context.js",
    "host",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "contracts",
    "test",
    "icon.svg",
    "client-memory-src",
    "src/memory",
    "skills",
    "client.memory.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.2": "compatible",
        "0.2.2-rc.3": "compatible",
        "0.2.2-rc.4": "compatible",
        "0.2.2-rc.5": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
