{
  "name": "@local/dsh-turn-cost",
  "version": "1.16.0",
  "private": true,
  "type": "module",
  "description": "Per-turn and session cost in CNY/USD at official list prices; sessions own a Context tab (breakdown, commands, files) and a cross-session usage overview with subscription quota. Settings hold every preference: cost (badge/pill, currency, billing tier, budget), model catalog sync, and project memory plus notes retrieval.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "cost-tracking",
    "token-usage",
    "llm-pricing",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.context.js": "./client.context.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client.memory.js": "./client.memory.js"
  },
  "files": [
    "index.js",
    "client.js",
    "client.context.js",
    "host",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "contracts",
    "test",
    "icon.svg",
    "client-memory-src",
    "src/memory",
    "skills",
    "client.memory.js",
    "host/notes",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.2": "compatible",
        "0.2.2-rc.3": "compatible",
        "0.2.2-rc.4": "compatible",
        "0.2.2-rc.5": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
