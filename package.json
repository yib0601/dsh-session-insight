{
  "name": "@local/dsh-session-insight",
  "version": "1.18.0",
  "private": true,
  "type": "module",
  "description": "Everything a DSH session should show about itself: per-turn and session cost at official list prices (CNY/USD), the context breakdown and cross-session usage overview, subscription quota with its reset countdown, self-hosted gateway model-catalog sync, and a cross-session project memory engine plus notes retrieval. Every preference lives in its own settings pages.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "cost-tracking",
    "token-usage",
    "llm-pricing",
    "dashboard",
    "context-inspector",
    "subscription-quota",
    "model-catalog",
    "project-memory",
    "notes-search"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.context.js": "./client.context.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client.memory.js": "./client.memory.js"
  },
  "files": [
    "index.js",
    "client.js",
    "client.context.js",
    "host",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "contracts",
    "test",
    "icon.svg",
    "client-memory-src",
    "src/memory",
    "skills",
    "client.memory.js",
    "host/notes",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": []
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.2": "compatible",
        "0.2.2-rc.3": "compatible",
        "0.2.2-rc.4": "compatible",
        "0.2.2-rc.5": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
